---
import { services } from "../data/services";

const serviceLinks = [
	{ href: "/services", label: "All services", icon: "" },
	...services.map((s) => ({ href: `/services#${s.id}`, label: s.title, icon: s.icon })),
];

const nav = [
	{ href: "/", label: "Home" },
	{ href: "/services", label: "Services", children: serviceLinks },
	{ href: "/about", label: "About" },
	{ href: "/contact", label: "Contact" },
];

const currentPath = Astro.url.pathname;
---

<header class="site-header">
	<div class="container inner">
		<a href="/" class="logo">
			<span class="logo-word">Monomedia</span>
			<span class="logo-tag">design | dev | copy</span>
		</a>

		<nav class="nav-desktop">
			<ul>
				{nav.map((item) => (
					<li class:list={{ "has-menu": item.children }}>
						<a
							href={item.href}
							aria-current={currentPath === item.href ? "page" : undefined}
						>
							{item.label}
							{item.children && <span class="chev" aria-hidden="true" />}
						</a>
						{item.children && (
							<ul class="submenu">
								{item.children.map((child) => (
									<li>
										<a href={child.href}>
											{child.icon && <span class="sub-icon" aria-hidden="true">{child.icon}</span>}
											{child.label}
										</a>
									</li>
								))}
							</ul>
						)}
					</li>
				))}
			</ul>
		</nav>

		<a href="/contact" class="btn btn-primary cta">Start a project</a>

		<button class="menu-toggle" type="button" aria-expanded="false" aria-controls="mobile-nav">
			<span></span>
			<span></span>
		</button>
	</div>

	<nav class="nav-mobile" id="mobile-nav" hidden>
		<ul>
			{nav.map((item) => (
				<li>
					<a href={item.href} aria-current={currentPath === item.href ? "page" : undefined}>
						{item.label}
					</a>
					{item.children && (
						<ul class="sub">
							{item.children.slice(1).map((child) => (
								<li>
									<a href={child.href}>{child.label}</a>
								</li>
							))}
						</ul>
					)}
				</li>
			))}
			<li><a href="/contact">Start a project</a></li>
		</ul>
	</nav>
</header>

<script>
	const toggle = document.querySelector<HTMLButtonElement>(".menu-toggle");
	const mobileNav = document.getElementById("mobile-nav");

	toggle?.addEventListener("click", () => {
		const isOpen = toggle.getAttribute("aria-expanded") === "true";
		toggle.setAttribute("aria-expanded", String(!isOpen));
		toggle.classList.toggle("is-open", !isOpen);
		if (mobileNav) mobileNav.hidden = isOpen;
	});
</script>

<style>
	.site-header {
		border-bottom: 1px solid var(--border);
		position: relative;
	}

	.inner {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 2em;
		padding-top: 1.5em;
		padding-bottom: 1.5em;
	}

	.logo {
		display: flex;
		flex-direction: column;
		gap: 0;
		line-height: 1;
	}

	.logo-word {
		font-weight: 700;
		font-size: 1.15em;
		letter-spacing: -0.01em;
		line-height: 1;
	}

	.logo-tag {
		font-size: 0.72em;
		font-weight: 500;
		letter-spacing: 0.02em;
		text-align: center;
		line-height: 1.3;
		color: var(--text-muted);
	}

	.nav-desktop ul {
		display: flex;
		gap: 2em;
	}

	.nav-desktop a {
		color: var(--text-muted);
		font-size: 0.95em;
		font-weight: 500;
		transition: color 0.15s ease;
	}

	.nav-desktop a:hover,
	.nav-desktop a[aria-current="page"] {
		color: var(--text);
	}

	.nav-desktop > ul {
		align-items: center;
	}

	.nav-desktop > ul > li {
		padding: 0.6em 0;
	}

	.has-menu {
		position: relative;
	}

	.chev {
		display: inline-block;
		width: 0.4em;
		height: 0.4em;
		margin-left: 0.5em;
		border-right: 1.5px solid currentColor;
		border-bottom: 1.5px solid currentColor;
		transform: rotate(45deg) translateY(-2px);
	}

	.nav-desktop .submenu {
		display: none;
		flex-direction: column;
		gap: 0;
		position: absolute;
		top: 100%;
		left: 50%;
		transform: translateX(-50%);
		min-width: 14em;
		padding: 0.5em;
		background: var(--bg);
		border: 1px solid var(--border);
		border-radius: var(--radius);
		box-shadow: 0 12px 32px color-mix(in srgb, #1d1f20 14%, transparent);
		z-index: 10;
	}

	.has-menu:hover > .submenu,
	.has-menu:focus-within > .submenu {
		display: flex;
	}

	.nav-desktop .submenu a {
		display: flex;
		align-items: center;
		gap: 0.6em;
		padding: 0.55em 0.85em;
		border-radius: 8px;
		white-space: nowrap;
	}

	.nav-desktop .submenu a:hover {
		background: var(--bg-raised);
		color: var(--text);
	}

	.sub-icon {
		font-size: 1.1em;
	}

	.cta {
		padding: 0.65em 1.35em;
		font-size: 0.85em;
	}

	.menu-toggle {
		display: none;
		flex-direction: column;
		justify-content: center;
		gap: 5px;
		width: 2.25em;
		height: 2.25em;
		background: transparent;
		border: 1px solid var(--border-strong);
		border-radius: 8px;
		cursor: pointer;
	}

	.menu-toggle span {
		display: block;
		margin: 0 auto;
		width: 1.1em;
		height: 2px;
		background: var(--text);
		transition: transform 0.15s ease, opacity 0.15s ease;
	}

	.menu-toggle.is-open span:first-child {
		transform: translateY(3.5px) rotate(45deg);
	}

	.menu-toggle.is-open span:last-child {
		transform: translateY(-3.5px) rotate(-45deg);
	}

	.nav-mobile {
		display: none;
		border-top: 1px solid var(--border);
		padding: 1em 0 1.5em 0;
	}

	.nav-mobile ul {
		display: flex;
		flex-direction: column;
		gap: 1.25em;
		padding: 0 1.75em;
	}

	.nav-mobile a {
		color: var(--text-muted);
		font-size: 1.05em;
		font-weight: 500;
	}

	.nav-mobile a[aria-current="page"] {
		color: var(--text);
	}

	.nav-mobile .sub {
		gap: 0.75em;
		padding: 0.9em 0 0 1.1em;
	}

	.nav-mobile .sub a {
		font-size: 0.95em;
	}

	@media (max-width: 640px) {

		.nav-desktop, .cta {
			display: none;
		}

		.menu-toggle {
			display: flex;
		}

		.nav-mobile:not([hidden]) {
			display: block;
		}

	}
</style>
