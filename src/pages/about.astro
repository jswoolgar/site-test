---
import Layout from "../layouts/Layout.astro";

const principles = [
	{
		title: "We give it to you straight",
		description: "Honest advice first, even when it’s “please leave your site alone.” That one’s a freebie.",
	},
	{
		title: "Faster, without cutting corners",
		description: "Speed is the goal. Shortcuts are not. We’ve yet to meet a corner worth cutting.",
	},
	{
		title: "Built for everyone",
		description: "Accessibility isn’t a bonus round. It’s in the plan from day one, right next to “make it pretty.”",
	},
	{
		title: "Easy to work with",
		description: "Clear updates, real answers, and a team that actually replies. Revolutionary, we know.",
	},
	{
		title: "We stick around",
		description: "Launch day is the beginning, not the goodbye. We stay for the updates, the questions, and the occasional panic.",
	},
	{
		title: "Small enough to care",
		description: "Fewer clients, more attention. You get a name and a face, not a ticket number.",
	},
];
---

<Layout title="About">
	<section class="intro">
		<div class="container center">
			<span class="eyebrow">About</span>
			<h1>We are Monomedia</h1>
			<p class="lede">
				A small team that makes websites (and the occasional intervention)
				faster, better, and built for everyone.
			</p>
		</div>
	</section>

	<section class="story">
		<div class="container story-grid">
			<div>
			<div class="section-head">
				<span class="eyebrow alt">Our Story</span>
				<h2>The first step is the hardest.</h2>
			</div>
			<div class="story-copy">
				<p>
					Call it a website, call it a project, call it a store &mdash; heck,
					call it an intervention. Point is, if you have a problem with your
					online (or mobile) presence, we&rsquo;re here to help. Like the sign
					says, it&rsquo;s our business to make sure your website gets to work
					faster for everyone, everywhere.
				</p>
				<p>
					All it takes is a nudge on your part to get us into gear, and
					we&rsquo;ll take it from there. We&rsquo;ll give you our best advice
					about next steps, even if that advice is to leave your site alone,
					or to contact a different firm or specialist.
				</p>
				<p>
					Use the <a href="/contact">contact form</a>, or
					<a href="mailto:hello@monomedia.co">drop us a note</a>, or
					<a href="tel:+10000000000">pick up the phone</a> (meaning, yes,
					it&rsquo;s fine to hit us up with a text).
				</p>
			</div>
			</div>
			<img
				class="photo story-photo"
				src="/images/about-team.jpg"
				alt="A small team gathered around a laptop, smiling at something on the screen"
				width="1400"
				height="933"
				loading="lazy"
			/>
		</div>
	</section>

	<section class="ceo">
		<div class="container ceo-grid">
			<figure class="headshot">
				<img
					src="/images/richard-sullivan.jpg"
					alt="Richard Sullivan, CEO of Monomedia (a very distinguished elephant)"
					width="480"
					height="480"
				/>
				<figcaption>The official headshot. Please don&rsquo;t ask.</figcaption>
			</figure>
			<div class="ceo-copy">
				<span class="eyebrow alt">Leadership</span>
				<h2>Meet Richard Sullivan</h2>
				<p class="role">Chief Executive Officer</p>
				<p>
					Richard Sullivan founded Monomedia on one firm belief: websites
					should be fast, and an elephant never forgets. That&rsquo;s why he
					remembers every client, every deadline, and &mdash; to the dismay of
					our design team &mdash; every typo anyone has ever made in a footer.
				</p>
				<p>
					He&rsquo;s the elephant in every room, in the good way: the one who
					finally says the quiet part out loud and then asks if anyone wants
					lunch. Big-picture thinker, big-hearted boss, and, we say this with
					love, big on personal space.
				</p>
				<p>
					When he&rsquo;s not steering the company, Richard enjoys long walks,
					large meals, and a good mud bath. Ask him the secret to site speed
					and he&rsquo;ll tell you: never stop moving, and always keep plenty
					of peanuts on hand.
				</p>
			</div>
		</div>
	</section>

	<section class="principles">
		<div class="container">
			<div class="section-head">
				<span class="eyebrow alt">How We Work</span>
				<h2>Principles we live by (and occasionally laminate)</h2>
			</div>
			<div class="grid grid-3">
				{principles.map((principle) => (
					<div class="card">
						<h3>{principle.title}</h3>
						<p>{principle.description}</p>
					</div>
				))}
			</div>
		</div>
	</section>
</Layout>

<style>
	.intro {
		padding-top: 7em;
		padding-bottom: 4em;
	}

	.intro h1 {
		margin: 0.5em 0;
		font-size: 2.5em;
	}

	.lede {
		max-width: 32em;
		margin: 0 auto;
		font-size: 1.1em;
	}

	.story {
		border-top: 1px solid var(--border);
	}

	.story-grid {
		display: grid;
		grid-template-columns: 1.3fr 1fr;
		gap: 4em;
		align-items: center;
	}

	.story-photo {
		aspect-ratio: 4 / 5;
		object-position: 50% 40%;
	}

	.story h2 {
		max-width: 20em;
	}

	@media (max-width: 780px) {

		.story-grid {
			grid-template-columns: 1fr;
			gap: 2.5em;
		}

		.story-photo {
			aspect-ratio: 3 / 2;
		}

	}

	.story-copy {
		max-width: 42em;
		display: flex;
		flex-direction: column;
		gap: 1.25em;
	}

	.story-copy a {
		color: var(--accent);
		text-decoration: underline;
	}

	.ceo {
		border-top: 1px solid var(--border);
	}

	.ceo-grid {
		display: grid;
		grid-template-columns: 1fr 1.6fr;
		gap: 4em;
		align-items: center;
	}

	.headshot {
		margin: 0;
	}

	.headshot img {
		width: 100%;
		height: auto;
		aspect-ratio: 1 / 1;
		object-fit: cover;
		object-position: 62% 30%;
		border-radius: var(--radius);
	}

	.headshot figcaption {
		margin-top: 0.75em;
		font-size: 0.85em;
		color: var(--text-muted);
		text-align: center;
	}

	.ceo-copy {
		display: flex;
		flex-direction: column;
		align-items: flex-start;
		gap: 1em;
	}

	.ceo-copy h2 {
		font-size: 2em;
	}

	.ceo-copy .role {
		margin-top: -0.5em;
		font-size: 0.8em;
		font-weight: 700;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		color: var(--accent);
	}

	@media (max-width: 780px) {

		.ceo-grid {
			grid-template-columns: 1fr;
			gap: 2em;
		}

		.headshot {
			max-width: 18em;
		}

	}

	.principles {
		border-top: 1px solid var(--border);
	}

	.principles h3 {
		font-size: 1.05em;
		margin-bottom: 0.5em;
	}

	.principles p {
		font-size: 0.95em;
	}
</style>
