---
import Layout from "../layouts/Layout.astro";
import ServiceCard from "../components/ServiceCard.astro";
import { services } from "../data/services";
---

<Layout title="Home">
	<section class="hero">
		<div class="container">
			<span class="eyebrow">When it comes to your website</span>
			<h1>Faster is better.<br />Faster for everyone is better still.</h1>
			<p class="lede">
				We&rsquo;re Monomedia, and we make websites that get to work faster, look
				better, and deliver the goods. For everyone.
			</p>
			<div class="actions">
				<a href="/contact" class="btn btn-primary">Start a project</a>
				<a href="#services" class="btn btn-secondary">Our services</a>
			</div>
		</div>
	</section>

	<section id="services">
		<div class="container">
			<div class="section-head center">
				<span class="eyebrow alt">What We Do</span>
				<h2>Everything your site needs, under one roof. We checked for leaks.</h2>
			</div>
			<div class="grid grid-services">
				{services.map((service) => (
					<ServiceCard
						icon={service.icon}
						title={service.title}
						description={service.short}
						tone={service.tone}
						href={`/services#${service.id}`}
					/>
				))}
			</div>
			<div class="more">
				<a href="/services" class="btn btn-secondary">See all services</a>
			</div>
		</div>
	</section>

	<section class="feature">
		<div class="container feature-grid">
			<img
				class="photo"
				src="/images/home-workspace.jpg"
				alt="A laptop, a cup of coffee, and a potted plant on a wooden desk"
				width="1400"
				height="833"
				loading="lazy"
			/>
			<div class="feature-copy">
				<span class="eyebrow alt">Why Monomedia</span>
				<h2>We like fast sites and friendly people.</h2>
				<p>
					Slow websites lose visitors. Slow agencies lose clients. We try very
					hard to avoid both: quick to respond, quick to build, and quick to tell
					you when something isn&rsquo;t worth doing.
				</p>
				<p>
					No jargon, no mystery invoices, no disappearing acts. Just a small team
					that picks up the phone and gets your site working faster, for everyone.
				</p>
				<a href="/about" class="btn btn-secondary">Meet the team</a>
			</div>
		</div>
	</section>

	<section class="cta-band">
		<div class="container center">
			<span class="eyebrow">Let&rsquo;s Talk</span>
			<h2>Ready to get to work?</h2>
			<p>
				All it takes is a nudge on your part to get us into gear, and
				we&rsquo;ll take it from there.
			</p>
			<a href="/contact" class="btn btn-primary">Get in touch</a>
		</div>
	</section>
</Layout>

<style>
	.hero {
		padding: 8em 0 6em 0;
		text-align: center;
	}

	.hero h1 {
		margin: 0.6em auto 0.5em auto;
		max-width: 16em;
		font-size: 2.75em;
	}

	.lede {
		max-width: 34em;
		margin: 0 auto 2em auto;
		font-size: 1.1em;
	}

	.actions {
		display: flex;
		justify-content: center;
		gap: 1em;
		flex-wrap: wrap;
	}

	.more {
		margin-top: 2.5em;
		text-align: center;
	}

	.feature {
		border-top: 1px solid var(--border);
	}

	.feature-grid {
		display: grid;
		grid-template-columns: 1.1fr 1fr;
		gap: 4em;
		align-items: center;
	}

	.feature-copy {
		display: flex;
		flex-direction: column;
		align-items: flex-start;
		gap: 1em;
	}

	.feature-copy h2 {
		font-size: 2em;
	}

	@media (max-width: 780px) {

		.feature-grid {
			grid-template-columns: 1fr;
			gap: 2em;
		}

	}

	@media (max-width: 640px) {

		.hero {
			padding: 5em 0 3em 0;
		}

		.hero h1 {
			font-size: 2em;
		}

	}
</style>
